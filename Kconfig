mainmenu "Smart Health Band"

source "Kconfig.zephyr"

menu "Smart Health Band"

config SHB_LOG_LEVEL
	int "Firmware log level"
	range 0 4
	default 3

config SHB_BMI_ANYMOTION_WAKE
	bool "Enable BMI270 any-motion wake"
	default y

config SHB_BMI_ANYMOTION_DURATION_MS
	int "BMI270 any-motion duration (ms)"
	range 20 1000
	default 20
	help
	  Shorter duration is needed to catch impulsive taps. The tap peak
	  verification in firmware then filters out non-tap motion.

config SHB_BMI_ANYMOTION_THRESHOLD_MG
	int "BMI270 any-motion threshold (mg)"
	range 1 1000
	default 500
	help
	  Initial gate for the BMI270 any-motion IRQ. Raised to 500 mg so
	  sustained wrist motion and finger pressure on the PPG sensor do
	  not wake the CPU. Real impulsive taps still produce far higher
	  peaks and fire reliably.

config SHB_BMI_TAP_IMPULSE_MG
	int "Tap impulse threshold: |a|-1g at IRQ-time sample (mg)"
	range 200 3000
	default 600
	help
	  After the any-motion IRQ the firmware samples total accel magnitude
	  and subtracts 1 g (gravity baseline). A real tap briefly spikes
	  well above 1 g; anything below this threshold is rejected as
	  sustained tilt / finger press / walking.

config SHB_BMI_TAP_DECAY_MG
	int "Tap decay threshold: impulse minus follow-up sample (mg)"
	range 100 2000
	default 400
	help
	  Taps are impulsive: the |a|-1g excursion must decay within ~25 ms.
	  A sustained tilt keeps |a| at ~1 g+constant so decay ~= 0 and is
	  rejected. Real taps show decay >> 400 mg between back-to-back
	  samples.

config SHB_BMI_MOTION_ACCEL_THRESHOLD_MG
	int "BMI270 poll-based motion accel delta threshold (mg)"
	range 1 2000
	default 50

config SHB_BMI_MOTION_GYRO_THRESHOLD_MDPS
	int "BMI270 poll-based motion gyro threshold (mdps)"
	range 100 2000000
	default 5000

config SHB_BMI_NO_MOTION_DURATION_MS
	int "BMI270 poll-based no-motion duration (ms)"
	range 100 60000
	default 3000

config SHB_BMI_SIG_MOTION_DURATION_MS
	int "BMI270 poll-based significant-motion duration (ms)"
	range 1000 60000
	default 5000

config SHB_BMI_DOUBLE_TAP_GAP_MS
	int "Maximum gap between two taps for double-tap classification (ms)"
	range 100 800
	default 350
	help
	  Also doubles as the single-tap confirmation timer — a first tap that
	  is not followed by a second within this window is emitted as a
	  single tap.

config SHB_BMI_DOUBLE_TAP_MIN_GAP_MS
	int "Minimum gap between taps to suppress ringing noise (ms)"
	range 50 300
	default 100

config SHB_BMI_TAP_REFRACTORY_MS
	int "Blanking period after any tap event is emitted (ms)"
	range 100 1500
	default 700

config SHB_BMI_INTERRUPT_WATCHDOG_S
	int "BMI270 interrupt watchdog (s)"
	range 0 3600
	default 30

config SHB_SENSOR_POLL_INTERVAL_MS
	int "Sensor poll interval (ms)"
	range 100 60000
	default 1000

config SHB_MAX32664_AGC_ENABLED
	bool "Enable MAX32664 automatic gain control (AGC)"
	default y

config SHB_MAX32664_CAL_TIMEOUT_S
	int "MAX32664 BPT calibration timeout (s, 0 = none)"
	range 0 600
	default 90
	help
	  If BPT calibration progress does not reach 100% within this
	  window, abort the calibration loop instead of blocking forever.
	  The hub's progress counter only advances under continuously
	  stable PPG; wrist placement routinely fails to accumulate
	  because tendon motion keeps resetting it. With a timeout we at
	  least exit cleanly and the main loop can continue running
	  temperature/tap/BLE without the session stuck.

config SHB_MAX32664_THREAD_STACK_SIZE
	int "MAX32664 session thread stack size (bytes)"
	range 2048 8192
	default 4096

config SHB_MAX32664_THREAD_PRIORITY
	int "MAX32664 session thread priority"
	range 1 14
	default 5

config SHB_MAX32664_BP_SYS_REF_0
	int "Systolic BP reference 0 (mmHg)"
	range 60 200
	default 120

config SHB_MAX32664_BP_SYS_REF_1
	int "Systolic BP reference 1 (mmHg)"
	range 60 200
	default 122

config SHB_MAX32664_BP_SYS_REF_2
	int "Systolic BP reference 2 (mmHg)"
	range 60 200
	default 125

config SHB_MAX32664_BP_DIA_REF_0
	int "Diastolic BP reference 0 (mmHg)"
	range 40 130
	default 80

config SHB_MAX32664_BP_DIA_REF_1
	int "Diastolic BP reference 1 (mmHg)"
	range 40 130
	default 81

config SHB_MAX32664_BP_DIA_REF_2
	int "Diastolic BP reference 2 (mmHg)"
	range 40 130
	default 82

config SHB_MAX32664_SPO2_COEF_A
	int "SpO2 coefficient A scaled by 100000 (Maxim default: round(1e5 x 1.5958422) = 159584)"
	default 159584

config SHB_MAX32664_SPO2_COEF_B
	int "SpO2 coefficient B scaled by 100000 (Maxim default: round(1e5 x -34.659664) = -3465966)"
	default -3465966

config SHB_MAX32664_SPO2_COEF_C
	int "SpO2 coefficient C scaled by 100000 (Maxim default: round(1e5 x 112.68987) = 11268987)"
	default 11268987

endmenu
